# NVIDIA API key (required) — create one at https://build.nvidia.com/settings
NVIDIA_API_KEY=nvapi-your_nvidia_key_here

# NVIDIA Nemotron model (optional). Served through the OpenAI-compatible NIM API.
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Pinecone API key (required for vector retrieval)
# Get your key at: https://app.pinecone.io/
PINECONE_API_KEY=pcsk_your_pinecone_api_key_here

# Pinecone configuration (optional - defaults shown)
PINECONE_INDEX_NAME=miet-jammu-index
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Server port. Render overrides this. Local and docker-compose use 10000.
PORT=10000

# Browser origins allowed to call the API. Use * or the Vercel URL.
# Example: https://your-app.vercel.app
CORS_ORIGINS=*
CORS_ALLOW_VERCEL_PREVIEWS=true

# JWT secret key for authentication (REQUIRED - change to a secure random string)
# Generate a secure secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# MongoDB connection string (REQUIRED for authentication)
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
# Local MongoDB: mongodb://localhost:27017
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=miety_ai

# First administrator (optional). Created once on startup when no admin exists.
# Email must look like yourname.dept@mietjammu.in
BOOTSTRAP_ADMIN_EMAIL=admin.office@mietjammu.in
BOOTSTRAP_ADMIN_PASSWORD=change-this-password
BOOTSTRAP_ADMIN_NAME=MIET Administrator

# Project workspace options (optional)
PROJECT_UPLOAD_MAX_MB=10
PROJECT_STREAM_RATE_LIMIT_PER_MIN=20
PROJECT_UPLOAD_RATE_LIMIT_PER_MIN=30
